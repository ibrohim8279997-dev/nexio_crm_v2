APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.example.uz
FRONTEND_URL=https://crm.example.uz
SEED_DEMO_DATA=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexio_crm
DB_USERNAME=postgres
DB_PASSWORD=
AI_PROVIDER=groq
GROQ_API_KEY=
AI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2048
AI_CA_BUNDLE=
# For MySQL instead, set DB_CONNECTION=mysql and replace the DB_* values above.

# Click Merchant
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=https://crm.example.uz/app/billing
PAYMENT_PROVIDER=click

# Telegram and SMTP
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://crm.example.uz/api/webhooks/telegram
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Nexio CRM

# Delivery providers (credentials should be stored encrypted per plugin connection.)
YANDEX_DELIVERY_CLIENT_ID=
YANDEX_DELIVERY_API_KEY=
# Delivery and telephony credentials are entered per plugin connection in CRM Settings.
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_SCHEME=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CBU_EXCHANGE_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json
CBU_EXCHANGE_TIMEOUT=8

# ── Nexio Plugin System ──────────────────────────────────────────────────────────────
# Encryption key for plugin secrets (provider credentials). REQUIRED before any plugin
# credential can be stored. Generate with:
#   php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
# Keep it OUT of the database and out of version control: the point is that a database
# dump alone does not expose customer credentials.
PLUGIN_SECRETS_KEY=
# Third-party executable plugins stay uninstallable until a real isolation runtime exists.
PLUGIN_SANDBOX_AVAILABLE=false
# Reported by the compatibility check against plugin manifests (min_nexio_version).
NEXIO_VERSION=2.0.0
