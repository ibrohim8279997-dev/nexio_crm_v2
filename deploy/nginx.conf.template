# Nexio CRM — Nginx site. setup-server.sh fills __DOMAIN__, __APP_DIR__, __PHP_VERSION__.
# SPA (dist/) and the Laravel API share one origin, so the frontend is built with an
# empty VITE_API_BASE_URL.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    client_max_body_size 20M;
    root __APP_DIR__/dist;
    index index.html;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API -> Laravel (PHP-FPM)
    location /api/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME __APP_DIR__/backend/public/index.php;
        fastcgi_param DOCUMENT_ROOT __APP_DIR__/backend/public;
        fastcgi_pass unix:/run/php/php__PHP_VERSION__-fpm.sock;
        fastcgi_read_timeout 120;
    }

    # Hashed build assets can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
