[Unit]
Description=Nexio CRM queue worker
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=__APP_DIR__/backend
ExecStart=/usr/bin/php__PHP_VERSION__ artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
