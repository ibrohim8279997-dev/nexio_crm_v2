# Nexio CRM — local development.
# Only public browser configuration belongs in this file. Keep API keys, Click
# secrets, bot tokens and provider credentials in backend/.env.
ENVIRONMENT=development
VITE_APP_NAME=Nexio CRM
VITE_API_TARGET=http://127.0.0.1:8000
# Leave empty for same-origin deployment. For a separately hosted SPA, use the
# backend origin, e.g. https://crmb.nexiolab.uz (the client appends /api/...).
VITE_API_BASE_URL=
